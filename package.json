{
  "name": "@webship-js/webflow-steps",
  "version": "2.0.1",
  "description": "Step definitions for webship-js that understand the markup Webflow publishes: the Navbar, the current page link, CMS collection lists and forms.",
  "main": "index.js",
  "files": [
    "index.js",
    "tests/step-definitions/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "cucumber-js --config cucumber.js",
    "test:chromium": "BROWSER=chromium cucumber-js --config cucumber.js",
    "test:firefox": "BROWSER=firefox cucumber-js --config cucumber.js",
    "test:webkit": "BROWSER=webkit cucumber-js --config cucumber.js",
    "test:report": "generate-reports",
    "test:examples": "node scripts/check-examples.js",
    "test:live": "node scripts/run-live.js",
    "demo:start": "cd demo-site && ddev start",
    "demo:stop": "cd demo-site && ddev stop",
    "demo:serve": "npx --yes http-server demo-site -p 8080 -s"
  },
  "keywords": [
    "webflow",
    "webship-js",
    "cucumber",
    "playwright",
    "bdd",
    "testing",
    "step-definitions",
    "plugin"
  ],
  "author": "Webship.co",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webship/webflow-steps.git"
  },
  "bugs": {
    "url": "https://github.com/webship/webflow-steps/issues"
  },
  "homepage": "https://github.com/webship/webflow-steps#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">= 20.0"
  },
  "peerDependencies": {
    "webship-js": "^2.0.6"
  },
  "devDependencies": {
    "webship-js": "^2.0.6",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.0"
  },
  "overrides": {
    "@cucumber/cucumber": "^12"
  }
}
